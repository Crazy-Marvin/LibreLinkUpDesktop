{
  "compilerOptions": {
    "incremental": true,
    "target": "es2021",
    "module": "commonjs",
    "lib": ["dom", "es2021"],
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./renderer/*"]
    },
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": ".erb/dll"
  },
  "include": [
    "src/**/*",
    ".erb/**/*.ts",
    ".erb/**/*.tsx",
    ".erb/**/*.js",
    ".eslintrc.js",
    "assets/**/*.d.ts",
    "postcss.config.js",
    "tailwind.config.js"
  ],
  "exclude": ["test", "release/build", "release/app/dist", ".erb/dll"]
}
